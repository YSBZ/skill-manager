# Company-private online-update config — COPY to build/update.local (gitignored)
# on the build machine to enable the desktop self-update against the company
# GitLab. A public build omits build/update.local → the update check is disabled
# and NO company info enters the binary or the repo.
#
#   cp build/update.local.example build/update.local   # then fill in, on the build machine only
#
# Makefile `-include`s build/update.local and injects these via
# -ldflags -X main.updateFeed / -X main.updateToken into both the web and desktop
# binaries. See docs/plans/phase6-online-update.md.

# URL of the feed's latest.json on the company GitLab (raw file or release asset).
# The app GETs it with the read-only token below (PRIVATE-TOKEN header).
UPDATE_FEED = https://<your-gitlab-host>/<group>/skill-manager/-/raw/main/release/latest.json

# A read-only GitLab Deploy Token scoped to this project (read_repository /
# read_package_registry). Internal, low-privilege, revocable. Lives ONLY here on
# the build machine; it is baked into the private binary, never committed.
UPDATE_TOKEN = <read-only-deploy-token>
