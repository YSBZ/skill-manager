# Optional local overrides for release builds. This file is only a template;
# copy it to the ignored build/update.local file before changing these values.
#
# The public source defaults to the anonymous GitHub feed in the Makefile.
# Keep UPDATE_TOKEN empty when the feed and release assets are public.
#
# Makefile `-include`s this local file and injects these values into the binary.

UPDATE_FEED = https://raw.githubusercontent.com/YSBZ/skill-manager/main/release/latest.json

# Optional read-only token, used only if a custom feed requires authentication.
UPDATE_TOKEN =

# Optional services; leave blank to disable them in this build.
FEEDBACK_ENDPOINT =
FEEDBACK_TOKEN =
CONTENT_SERVICE_URL =
